# BAB AL FKAMAH — configuration (copiez ce fichier en .env)
PORT=3000
# Port supplémentaire pour le nom de domaine (http://rest.babfkamah.com sans :3000). 0 = désactivé
PORT_WEB=80
DB_HOST=localhost
DB_PORT=3306
DB_USER=resto
DB_PASSWORD=resto_pass
DB_NAME=bab_al_fkamah
# Compte MySQL utilisé par « npm run init-db » pour créer la base (souvent root)
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
# Changez cette phrase secrète (sécurité des sessions)
JWT_SECRET=changez-moi-par-une-longue-phrase-secrete
# Serveur DNS local (server/dns.js)
DNS_DOMAINE=rest.babfkamah.com
DNS_AMONT=8.8.8.8,1.1.1.1
# DNS_IP=192.168.1.101
# HTTPS optionnel : placez key.pem et cert.pem dans le dossier certs/
HTTPS_PORT=3443
